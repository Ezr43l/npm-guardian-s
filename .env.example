# Copia este fichero como .env. La topología, las integraciones y los secretos se
# configuran desde el asistente web y se guardan bajo NPMG_DATA_DIR.
NPMG_IMAGE=ghcr.io/ezr43l/npm-guardian-s:1.0.4
LICENSE_SPDX=Apache-2.0
NPMG_CONTAINER_NAME=npm-guardian
NPMG_PUBLIC_PORT=6061
NPMG_BIND_ADDRESS=0.0.0.0

NPM_DATA_DIR=/srv/nginx-proxy-manager/data
NPM_LETSENCRYPT_DIR=/srv/nginx-proxy-manager/letsencrypt
NPMG_DATA_DIR=./data/guardian
DOCKER_SOCKET=/var/run/docker.sock
